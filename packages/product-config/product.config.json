{
  "displayName": "Mewvis",
  "namespace": "mewvis",
  "bundleName": "Mewvis",
  "windowTitle": "Mewvis",
  "appDataDirName": ".mewvis",
  "defaultWorkspaceDirName": "default-workspace",
  "storageKeyPrefix": "mewvis",
  "envPrefix": "MEWVIS",
  "versionControl": {
    "authorName": "Mewvis",
    "authorEmail": "mewvis@local"
  },
  "agentRuntimePackageName": "@mewvis/agent-runtime",
  "bundleIdentifier": "com.mewvis.desktop",
  "description": "Mewvis Desktop Client",
  "assets": {
    "brandMark": "/assets/startup/brand-mark.png"
  },
  "schemas": {
    "applicationOrigin": "https://mewvis.app",
    "runtimeOrigin": "https://mewvis.local"
  },
  "files": {
    "appConfig": "app.config.ts",
    "appUiScript": "app-ui.js",
    "appUiStyle": "app-ui.css"
  },
  "cli": {
    "application": "mewvis-app",
    "extension": "mewvis-extension"
  }
}
