{
  "name": "@mewvis/chat-contracts",
  "version": "0.1.0",
  "type": "module",
  "description": "UI-independent session and semantic message contracts shared by Mewvis and its application SDK.",
  "exports": {
    "./model-configuration": {
      "types": "./model-configuration.d.ts",
      "default": "./model-configuration.js"
    },
    "./model-capabilities.schema.json": "./model-capabilities.schema.json",
    "./agent-access.schema.json": "./agent-access.schema.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.d.ts",
    "agent-permissions.d.ts",
    "agent-access.d.ts",
    "agent-access.schema.json",
    "model-thinking.d.ts",
    "model-capabilities.d.ts",
    "model-capabilities.schema.json",
    "index.js",
    "model-configuration.js",
    "model-configuration.d.ts"
  ],
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "sideEffects": false
}
