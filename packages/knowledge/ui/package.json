{
  "name": "@mewvis/knowledge-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable knowledge workspace, management pages and components.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "pnpm --filter @mewvis/knowledge-sdk build && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mewvis/knowledge-sdk": "workspace:*",
    "design-system": "workspace:*",
    "lucide-react": "^0.500.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.28.0",
    "typescript": "~5.8.3"
  },
  "license": "MIT"
}
