{
  "name": "@isle/plugin-dev",
  "version": "0.1.0",
  "description": "React plugin development, preview and packaging for Isle.",
  "type": "module",
  "bin": {
    "isle-plugin": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    },
    "./tooling": "./src/tooling.mjs",
    "./preview": {
      "types": "./src/preview.d.ts",
      "default": "./src/preview.js"
    },
    "./tsconfig.json": "./tsconfig.json",
    "./dsh": "./src/dsh.mjs",
    "./cli": "./src/cli.mjs",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "src",
    "templates",
    "dist",
    "tsconfig.json",
    "client.d.ts"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepack": "node src/check-dist.mjs"
  },
  "dependencies": {
    "@isle/chat-contracts": "workspace:*",
    "@isle/plugin-sdk": "workspace:*",
    "@vitejs/plugin-react": "^4.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
