{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mewvis.app/schemas/mewvis-ui-v1.json",
  "title": "Mewvis Application UI Manifest",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "sandbox" },
    "entry": { "type": "string", "pattern": "^\\./.*\\.(m?js)$" },
    "style": { "type": "string", "pattern": "^\\./.*\\.css$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "layout": {
      "type": "string",
      "enum": ["workspace", "fullscreen"],
      "default": "fullscreen",
      "description": "Defaults to fullscreen, hiding host sidebars and retaining host exit controls. Use workspace to retain host sidebars."
    }
  },
  "required": ["version", "kind", "entry"],
  "additionalProperties": false
}
