{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mewvis Extension package.json",
  "type": "object",
  "required": ["name", "version", "type", "mewvis.extension"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "type": {
      "const": "module"
    },
    "mewvis.extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "apiVersion", "modules"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "apiVersion": {
          "const": 1
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "object"
                }
              }
            },
            "defaults": {
              "type": "object"
            }
          }
        },
        "schemaVersion": {
          "const": 2
        },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entry", "capabilities"],
              "properties": {
                "entry": {
                  "type": "string",
                  "minLength": 1
                },
                "capabilities": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "tools",
                      "skills",
                      "commands",
                      "session.state",
                      "events.run",
                      "events.tool",
                      "events.turn",
                      "events.message",
                      "events.session",
                      "middleware.input",
                      "middleware.system_prompt",
                      "middleware.context",
                      "middleware.tool_call",
                      "middleware.tool_result",
                      "middleware.session_compact"
                    ]
                  }
                }
              }
            },
            "ui": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contributions"],
              "properties": {
                "entry": {
                  "type": "string",
                  "minLength": 1
                },
                "contributions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "urn:mewvis:ui-contribution"
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "contributions": {
                        "contains": {
                          "type": "object",
                          "required": ["view"]
                        },
                        "type": "array"
                      }
                    }
                  },
                  "then": {
                    "required": ["entry"]
                  }
                }
              ]
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provides": {"type": "array", "uniqueItems": true, "items": {"enum": ["decisions.evaluate"]}},
            "required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "session.read",
                  "session.ledger.read",
                  "session.summarize",
                  "configuration.read",
                  "configuration.write",
                  "tasks.run",
                  "decisions.evaluate",
                  "activity.publish",
                  "activity.read",
                  "activity.cancel",
                  "activity.pause",
                  "activity.resume",
                  "activity.checkpoint"
                ]
              }
            },
            "optional": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "session.read",
                  "session.ledger.read",
                  "session.summarize",
                  "configuration.read",
                  "configuration.write",
                  "tasks.run",
                  "decisions.evaluate",
                  "activity.publish",
                  "activity.read",
                  "activity.cancel",
                  "activity.pause",
                  "activity.resume",
                  "activity.checkpoint"
                ]
              }
            }
          }
        }
      }
    }
  }
}
