{
  "name": "@isle/extension-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./agent": {
      "types": "./agent/index.d.ts",
      "default": "./agent/index.js"
    },
    "./ui": {
      "types": "./ui/index.d.ts",
      "default": "./ui/index.js"
    },
    "./host": {
      "types": "./host/index.d.ts",
      "default": "./host/adapter.js"
    },
    "./manifest.schema.json": "./manifest.schema.json",
    "./ui/contribution.schema.json": "./ui/contribution.schema.json"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-ui.mjs",
    "check:ui": "node scripts/generate-ui.mjs --check"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4"
  }
}
