{
  "name": "@isle/extension-decisions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智能判断：复用当前模型进行可配置的选择、评分与是非判断，支持斜杠引用和模型工具调用。",
  "scripts": {
    "build": "isle-extension build",
    "check": "tsc --noEmit",
    "test": "node test/run.mjs",
    "validate": "isle-extension validate dist/plugin"
  },
  "dependencies": {
    "@isle/extension-sdk": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@isle/extension-dev": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3",
    "esbuild": "^0.28.0"
  },
  "isle.extension": {
    "schemaVersion": 2,
    "apiVersion": 1,
    "id": "isle.decisions",
    "configuration": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profiles"
        ],
        "properties": {
          "profiles": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "instructions",
                    "threshold",
                    "type",
                    "choices"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,24}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "threshold": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "type": {
                      "const": "choice"
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 10,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "instructions",
                    "threshold",
                    "type",
                    "choices"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,24}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "threshold": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "type": {
                      "const": "score"
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 10,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "instructions",
                    "threshold",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,24}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "threshold": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "type": {
                      "const": "noul"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "defaults": {
        "profiles": [
          {
            "id": "classify",
            "name": "需求分类",
            "type": "choice",
            "instructions": "判断用户需求的主要类型。混合需求选择最主要的一项；与所有类别都不匹配时选择其他，缺少可判断材料时弃答。",
            "threshold": 0.7,
            "choices": [
              "问题咨询",
              "功能开发",
              "故障排查",
              "内容创作",
              "其他"
            ]
          },
          {
            "id": "quality",
            "name": "方案评分",
            "type": "score",
            "instructions": "评估方案的可执行程度，关注目标、具体步骤、约束和验证方法。只依据给出的内容评分，未给出方案时弃答。",
            "threshold": 0.7,
            "choices": [
              "不可执行：缺少目标和具体内容",
              "较弱：有想法但缺少步骤或关键条件",
              "基本可行：有明确步骤，仍有细节待补充",
              "完整可行：目标、步骤、约束与验证方法清楚"
            ]
          },
          {
            "id": "ready",
            "name": "执行条件判断",
            "type": "noul",
            "instructions": "判断需求是否提供了足够信息，可以直接开始实施而无需先确认关键问题。缺少目标、对象或关键约束时为否；材料无关或无法判断时弃答。",
            "threshold": 0.7
          }
        ]
      }
    },
    "host": {
      "optional": [
        "configuration.read",
        "configuration.write",
        "tasks.run"
      ]
    },
    "modules": {
      "agent": {
        "entry": "./index.js",
        "capabilities": [
          "commands",
          "tools"
        ]
      },
      "ui": {
        "entry": "./ui.js",
        "contributions": [
          {
            "id": "settings",
            "slot": "plugin.settings",
            "type": "settings",
            "title": "智能判断",
            "view": {
              "id": "settings"
            }
          }
        ]
      }
    }
  }
}
