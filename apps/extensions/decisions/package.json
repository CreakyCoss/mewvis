{
  "name": "@mewvis/extension-decisions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智能判断：复用当前模型进行可配置的选择、评分与是非判断，支持斜杠引用和模型工具调用。",
  "scripts": {
    "build": "mewvis-extension build",
    "check": "tsc --noEmit",
    "test": "node test/run.mjs",
    "validate": "mewvis-extension validate dist/plugin"
  },
  "dependencies": {
    "@mewvis/extension-sdk": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.2.0",
    "@mewvis/product-config": "workspace:*"
  },
  "devDependencies": {
    "@mewvis/extension-dev": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3",
    "esbuild": "^0.28.0"
  },
  "mewvis.extension": {
    "displayName": "智能判断",
    "schemaVersion": 2,
    "apiVersion": 1,
    "id": "mewvis.decisions",
    "configuration": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules"
        ],
        "properties": {
          "rules": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "enabled",
                "priority",
                "when",
                "instructions",
                "threshold"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,24}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "enabled": {
                  "type": "boolean"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "when": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "instructions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      },
      "defaults": {
        "rules": []
      }
    },
    "host": {
      "optional": [
        "configuration.read",
        "configuration.write",
        "tasks.run"
      ],
      "provides": [
        "decisions.evaluate"
      ]
    },
    "modules": {
      "agent": {
        "entry": "./index.js",
        "capabilities": [
          "commands",
          "tools"
        ]
      },
      "ui": {
        "entry": "./ui.js",
        "contributions": [
          {
            "id": "settings",
            "slot": "plugin.settings",
            "type": "settings",
            "title": "智能判断",
            "view": {
              "id": "settings"
            }
          },
          {
            "id": "rule-editor",
            "slot": "plugin.dialog",
            "type": "dialog",
            "title": "编辑判断规则",
            "size": "lg",
            "view": {
              "id": "rule-editor"
            }
          }
        ]
      }
    }
  }
}
