{
  "name": "@isle/extension-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "任务清单：命令管理任务，统一 Agent 事件驱动会话进度。",
  "scripts": {
    "build": "isle-extension build",
    "validate": "isle-extension validate dist/plugin",
    "pack": "isle-extension pack"
  },
  "dependencies": {
    "@isle/extension-sdk": "workspace:*",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@isle/extension-dev": "workspace:*"
  },
  "isle.extension": {
    "schemaVersion": 2,
    "id": "isle.tasks",
    "apiVersion": 1,
    "configuration": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maxTasks"
        ],
        "properties": {
          "maxTasks": {
            "title": "任务数量上限",
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        }
      },
      "defaults": {
        "maxTasks": 500
      }
    },
    "modules": {
      "agent": {
        "entry": "./index.js",
        "capabilities": [
          "commands",
          "session.state",
          "events.run",
          "events.tool"
        ]
      }
    }
  }
}
