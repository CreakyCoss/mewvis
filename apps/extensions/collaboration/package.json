{
  "name": "@isle/extension-collaboration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "用户自定义角色协作流程，支持斜杠命令、模型调用和实时步骤状态。",
  "scripts": {
    "build": "isle-extension build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@isle/extension-sdk": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@isle/extension-dev": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3"
  },
  "isle.extension": {
    "schemaVersion": 2,
    "apiVersion": 1,
    "id": "isle.collaboration",
    "configuration": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workflows": {
            "type": "array",
            "maxItems": 32,
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "description",
                "steps"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,24}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "maxLength": 2000
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "roleId",
                      "instruction",
                      "input"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "roleId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "instruction": {
                        "type": "string",
                        "maxLength": 8000
                      },
                      "input": {
                        "enum": [
                          "original",
                          "previous",
                          "all"
                        ]
                      },
                      "judgment": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "question",
                          "output"
                        ],
                        "properties": {
                          "question": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4000
                          },
                          "output": {
                            "oneOf": [
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "type",
                                  "options"
                                ],
                                "properties": {
                                  "type": {
                                    "const": "choice"
                                  },
                                  "options": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 10,
                                    "uniqueItems": true,
                                    "items": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 300
                                    }
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "type",
                                  "levels"
                                ],
                                "properties": {
                                  "type": {
                                    "const": "score"
                                  },
                                  "levels": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 10,
                                    "uniqueItems": true,
                                    "items": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 300
                                    }
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "type"
                                ],
                                "properties": {
                                  "type": {
                                    "const": "boolean"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "roles": {
            "type": "array",
            "maxItems": 64,
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "instructions",
                "avatar"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "instructions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "avatar": {
                  "enum": [
                    "compass",
                    "prism",
                    "spark",
                    "leaf",
                    "orbit",
                    "wave"
                  ]
                }
              }
            }
          }
        }
      },
      "defaults": {
        "workflows": [],
        "roles": []
      }
    },
    "host": {
      "optional": [
        "configuration.read",
        "configuration.write",
        "tasks.run",
        "activity.publish",
        "activity.read",
        "activity.cancel",
        "activity.pause",
        "activity.resume",
        "activity.checkpoint",
        "decisions.evaluate"
      ]
    },
    "modules": {
      "agent": {
        "entry": "./index.js",
        "capabilities": [
          "tools",
          "commands"
        ]
      },
      "ui": {
        "entry": "./ui.js",
        "contributions": [
          {
            "id": "settings",
            "slot": "plugin.settings",
            "type": "settings",
            "title": "角色协作流程",
            "view": {
              "id": "settings"
            }
          },
          {
            "id": "progress",
            "slot": "session.composer-status",
            "type": "status",
            "title": "角色协作"
          }
        ]
      }
    }
  }
}
