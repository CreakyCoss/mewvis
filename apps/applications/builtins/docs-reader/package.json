{
  "name": "@mewvis/docs-reader",
  "version": "0.1.0",
  "description": "离线中文文档中心，提供章节目录、全文搜索和 Markdown 阅读。",
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@mewvis/app-sdk": "^0.1.0",
    "@mewvis/product-config": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "mewvis": {
    "app": {
      "version": 1,
      "entry": "./index.js"
    },
    "displayName": "文档中心",
    "defaultEnabled": true,
    "permissions": [
      "open-external"
    ],
    "ui": {
      "version": 1,
      "kind": "sandbox",
      "entry": "./app-ui.js",
      "style": "./app-ui.css",
      "title": "文档中心"
    }
  }
}
