{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node", "react", "react-dom"],
    "skipLibCheck": true
  },
  "include": ["ui", "scripts/preview.tsx", "scripts/fixtures.ts"]
}
