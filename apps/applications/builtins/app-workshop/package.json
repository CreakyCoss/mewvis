{
  "name": "@mewvis/app-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "应用工坊：创建小应用，通过 AI 编辑代码，在工坊内预览和使用。",
  "scripts": {
    "prepare:runtime": "node scripts/runtime.mjs",
    "dev": "node scripts/preview.mjs",
    "check": "pnpm prepare:runtime && mewvis-app check && pnpm check:cat-packing",
    "check:cat-packing": "tsc -p mini-apps/cat-packing/source/tsconfig.json",
    "build": "pnpm prepare:runtime && mewvis-app build",
    "test": "pnpm --filter @mewvis/app-host build && pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mewvis/app-sdk": "workspace:*",
    "design-system": "workspace:*",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "typescript": "~5.8.3",
    "@mewvis/product-config": "workspace:*"
  },
  "devDependencies": {
    "@mewvis/app-dev": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.28.0",
    "vite": "^7.0.4"
  }
}
