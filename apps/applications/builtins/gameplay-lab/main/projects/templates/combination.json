{
  "format": "gameplay-card-v1",
  "id": "combination",
  "name": "组合计分",
  "description": "选择同类组合，还是投资倍率？用同一个运行器验证组合策略。",
  "fields": [
    {
      "id": "coins",
      "name": "可用筹码",
      "description": "可以用于调整倍率的资源",
      "initial": 4,
      "role": "stock"
    },
    {
      "id": "multiplier",
      "name": "计分倍率",
      "description": "放大组合的最终得分",
      "initial": 1,
      "role": "rate"
    },
    {
      "id": "score",
      "name": "累计得分",
      "description": "每次组合的得分累计",
      "initial": 0,
      "role": "progress"
    }
  ],
  "capabilities": [
    {
      "id": "scoring",
      "name": "组合识别",
      "description": "基础值之和，加上行动中配置的同类配对奖励，再乘倍率。",
      "initial": true
    }
  ],
  "actions": [
    {
      "id": "play",
      "name": "提交组合",
      "description": "从候选集合选择 1–3 个对象进行计分，然后补充候选。",
      "costs": [],
      "requires": ["scoring"],
      "effects": [
        {
          "type": "combination",
          "pairBonus": 15,
          "collection": "hand",
          "field": "score",
          "multiplier": "multiplier"
        }
      ]
    },
    {
      "id": "upgrade",
      "name": "提高倍率",
      "description": "投入筹码，换取后续更高得分。",
      "costs": [
        {
          "field": "coins",
          "value": 2
        }
      ],
      "requires": [],
      "effects": [
        {
          "type": "add",
          "field": "multiplier",
          "value": 1
        }
      ]
    },
    {
      "id": "earn",
      "name": "积累筹码",
      "description": "放弃本次计分机会，增加筹码。",
      "costs": [],
      "requires": [],
      "effects": [
        {
          "type": "add",
          "field": "coins",
          "value": 2
        }
      ]
    }
  ],
