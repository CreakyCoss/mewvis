{
  "name": "@mewvis/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @mewvis/extension-host build && pnpm --filter @mewvis/app-host build && tsc --noEmit && node scripts/build-cli.mjs && pnpm --filter @mewvis/builtin-applications build && node scripts/write-package.mjs && node scripts/copy-builtin-resources.mjs && node scripts/copy-builtin-skills.mjs && node scripts/build-builtin-extensions.mjs && node scripts/copy-application-installer.mjs && node scripts/copy-node-runtime.mjs",
    "check": "tsc --noEmit",
    "generate:protocol": "node protocol/scripts/generate-bindings.mjs",
    "check:protocol": "node protocol/scripts/generate-bindings.mjs --check",
    "test:extensions": "pnpm --filter @mewvis/extension-host build && node scripts/extensions-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@earendil-works/pi-ai": "workspace:*",
    "@earendil-works/pi-coding-agent": "workspace:*",
    "@mewvis/chat-contracts": "workspace:*",
    "@langchain/langgraph": "^1.4.7",
    "ajv": "^8.20.0",
    "lodash-es": "^4.18.1",
    "zod": "^4.2.0",
    "@mewvis/app-host": "workspace:*",
    "@earendil-works/chord": "workspace:*",
    "@mewvis/extension-host": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@mewvis/extension-dev": "workspace:*",
    "@mewvis/app-dev": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/lodash-es": "^4.17.12",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.3",
    "typescript": "~5.8.3",
    "json-schema-to-typescript": "15.0.4",
    "quicktype": "26.0.0",
    "pnpm": "11.7.0"
  }
}
