{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mewvis.local/protocol/agent-runtime/v1/notification.schema.json",
  "title": "Mewvis Agent Runtime JSON-RPC Notification",
  "oneOf": [
    {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "runtime/event" },
        "params": { "$ref": "./event.schema.json" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "runtime/result" },
        "params": { "$ref": "./result.schema.json" }
      },
      "additionalProperties": false
    }
  ]
}
