{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mewvis.local/protocol/agent-runtime/v1/model.schema.json",
  "title": "Agent Runtime Model Contracts",
  "definitions": {
    "RuntimeApiFormat": {
      "enum": [
        "anthropic-messages",
        "openai-completions",
        "openai-codex-responses",
        "openai-responses",
        "azure-openai-responses",
        "google-generative-ai",
        "openrouter"
      ]
    },
    "RuntimeThinkingLevel": {
      "type": "string"
    },
    "RuntimeThinkingOption": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": {
          "$ref": "#/definitions/RuntimeThinkingLevel"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "RuntimeModelThinking": {
      "type": "object",
      "required": ["levels"],
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuntimeThinkingOption"
          }
        },
        "defaultLevel": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "RuntimeModelInputModality": {
      "enum": ["text", "image"]
    },
    "RuntimeModelCost": {
      "type": "object",
      "required": ["input", "output", "cacheRead", "cacheWrite"],
      "properties": {
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "cacheRead": {
          "type": "number"
        },
        "cacheWrite": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "RuntimeModelInput": {
      "type": "object",
      "required": ["provider", "apiFormat", "catalogModelId", "modelId"],
      "properties": {
        "provider": {
          "type": "string"
        },
        "apiFormat": {
          "$ref": "#/definitions/RuntimeApiFormat"
        },
        "apiKey": {
          "type": ["string", "null"]
        },
        "catalogModelId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "apiEndpoint": {
          "type": ["string", "null"]
        },
        "reasoning": {
          "type": "boolean"
        },
        "thinkingLevel": {
          "oneOf": [
            {
              "$ref": "#/definitions/RuntimeThinkingLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuntimeModelInputModality"
          }
        },
        "cost": {
          "$ref": "#/definitions/RuntimeModelCost"
        },
        "contextWindow": {
          "type": "number"
        },
        "maxTokens": {
          "type": "number"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configuration": {
          "description": "Saved configuration for the selected model. Consumers validate it with the shared ModelConfiguration contract.",
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "capabilities": {
          "$ref": "#/definitions/RuntimeModelCapabilities"
        }
      },
      "additionalProperties": false
    },
    "RuntimeModel": {
      "oneOf": [
        {
          "$ref": "#/definitions/RuntimeModelInput"
        },
        {
          "type": "null"
        }
      ]
    },
    "RuntimeModelModality": {
      "enum": ["text", "image", "audio", "video"]
    },
    "RuntimeModelOperation": {
      "enum": [
        "chat",
        "image-generation",
        "image-editing",
        "video-generation",
        "speech",
        "transcription",
        "realtime"
      ]
    },
    "RuntimeModelCapabilities": {
      "type": "object",
      "required": ["operations", "input", "output", "reasoning", "toolCalling"],
      "properties": {
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/RuntimeModelOperation"
          }
        },
        "input": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/RuntimeModelModality"
          }
        },
        "output": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/RuntimeModelModality"
          }
        },
        "reasoning": {
          "type": "boolean"
        },
        "toolCalling": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "RuntimeModelLimits": {
      "type": "object",
      "properties": {
        "contextWindow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    }
  }
}
