{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "protocol/**/*.json",
    "../client/core/story-project/**/*.ts",
    "../client/core/story-project/**/*.json",
    "../client/core/protocol.ts",
    "../product.config.json"
  ]
}
