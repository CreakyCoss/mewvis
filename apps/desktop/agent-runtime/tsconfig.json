{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../core/story-project/api.ts",
    "../core/story-project/identifiers.ts",
    "../core/story-project/types.ts",
    "../core/story-project/compiler/**/*.ts",
    "../core/story-project/project/metadata.ts",
    "../core/story-project/project/registry.ts",
    "../core/protocol.ts",
    "../product.config.json"
  ]
}
