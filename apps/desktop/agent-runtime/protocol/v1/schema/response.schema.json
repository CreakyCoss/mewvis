{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://isle.local/protocol/agent-runtime/v1/response.schema.json",
  "title": "Isle Agent Runtime JSON-RPC Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
        "result": { "$ref": "./result.schema.json" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
