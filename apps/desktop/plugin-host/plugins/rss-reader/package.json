{
  "name": "@isle/rss-reader",
  "version": "0.1.0",
  "description": "兼容 DeepSeek Harness 的 RSS/Atom 阅读插件，提供订阅管理、抓取工具、模型技能与插件自带界面。",
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "dependencies": {
    "dsh-rss": "0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "isle": {
    "displayName": "RSS 阅读器",
    "defaultEnabled": false,
    "ui": {
      "version": 1,
      "kind": "sandbox",
      "entry": "./isle-ui.js",
      "style": "./isle-ui.css",
      "title": "RSS 阅读器",
      "layout": "full"
    }
  }
}
