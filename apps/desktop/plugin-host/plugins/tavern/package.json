{
  "name": "@isle/tavern",
  "version": "0.1.0",
  "description": "兼容 DeepSeek Harness 的酒馆插件，提供角色卡、世界书、预设管理和可注入的角色扮演上下文。",
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "isle": {
    "displayName": "酒馆",
    "defaultEnabled": true,
    "ui": {
      "version": 1,
      "kind": "sandbox",
      "entry": "./isle-ui.js",
      "style": "./isle-ui.css",
      "title": "酒馆工作台",
      "layout": "full"
    }
  }
}
