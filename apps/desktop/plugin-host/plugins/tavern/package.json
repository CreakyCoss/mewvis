{
  "name": "@isle/tavern",
  "version": "0.1.0",
  "description": "Isle 原生酒馆插件，提供角色卡、世界书、预设管理和可注入的角色扮演上下文。",
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "dependencies": {
    "@isle/plugin-sdk": "^0.1.0"
  },
  "isle": {
    "plugin": {
      "version": 1,
      "entry": "./index.js"
    },
    "displayName": "酒馆",
    "defaultEnabled": true,
    "permissions": [
      "plugin-data"
    ],
    "ui": {
      "version": 1,
      "kind": "sandbox",
      "entry": "./isle-ui.js",
      "style": "./isle-ui.css",
      "title": "酒馆工作台",
      "layout": "full"
    }
  }
}
