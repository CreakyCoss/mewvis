{
  "foreshadow": {
    "label": "伏笔",
    "description": "同一记录覆盖计划、埋设、推进和回收，避免伏笔与回收记录失去同步",
    "identityPointer": "/id",
    "fields": {
      "/id": {
        "type": "id",
        "label": "伏笔 ID",
        "required": true,
        "immutable": true
      },
      "/content": {
        "type": "textarea",
        "label": "伏笔内容",
        "description": "要埋设的事实、意象、信息差或未兑现承诺",
        "required": true
      },
      "/status": {
        "type": "enum",
        "label": "生命周期状态",
        "required": true,
        "options": [
          {
            "value": "planned",
            "label": "已计划"
          },
          {
            "value": "planted",
            "label": "已埋设"
          },
          {
            "value": "advanced",
            "label": "已推进"
          },
          {
            "value": "resolved",
            "label": "已回收"
          },
          {
            "value": "expired",
            "label": "已失效"
          },
          {
            "value": "abandoned",
            "label": "已放弃"
          }
        ]
      },
      "/importance": {
        "type": "enum",
        "label": "重要程度",
        "required": true,
        "options": [
          {
            "value": "high",
            "label": "高"
          },
          {
            "value": "medium",
            "label": "中"
          },
          {
            "value": "low",
            "label": "低"
          }
        ]
      },
      "/plannedPlantChapterId": {
        "type": "reference",
        "label": "计划埋设章节",
        "required": false,
        "targetKinds": ["story-chapter-plan"]
      },
      "/plantedChapterId": {
        "type": "reference",
        "label": "实际埋设章节",
        "required": false,
        "targetKinds": ["story-chapter"]
      },
      "/expectedResolveChapterId": {
        "type": "reference",
        "label": "预计回收章节",
        "required": false,
        "targetKinds": ["story-chapter-plan"]
      },
      "/resolvedChapterId": {
        "type": "reference",
        "label": "实际回收章节",
        "required": false,
        "targetKinds": ["story-chapter"]
      },
      "/relatedEntityIds": {
        "type": "reference-list",
        "label": "关联对象",
        "required": true,
        "targetKinds": ["story-character", "story-world-entry", "story-chapter-plan", "story-chapter"],
        "default": []
      },
      "/resolution": {
        "type": "textarea",
        "label": "回收结果",
        "description": "伏笔如何兑现、改变了什么认知或剧情状态",
        "required": true,
        "default": ""
      }
    },
    "ruleIds": ["foreshadow.resolution"]
  },
  "timeline-entry": {
    "label": "时间线事件",
    "identityPointer": "/id",
    "fields": {
      "/id": {
        "type": "id",
        "label": "事件 ID",
        "required": true,
        "immutable": true
      },
      "/chapterId": {
        "type": "reference",
        "label": "发生章节",
        "required": true,
        "targetKinds": ["story-chapter"]
      },
      "/storyTime": {
        "type": "text",
        "label": "故事内时间",
        "required": true
      },
      "/event": {
        "type": "textarea",
        "label": "事件",
        "required": true
      },
      "/participantIds": {
        "type": "reference-list",
        "label": "参与角色",
        "required": true,
        "targetKinds": ["story-character"],
        "default": []
      },
      "/worldRefIds": {
        "type": "reference-list",
        "label": "相关设定",
        "required": true,
        "targetKinds": ["story-world-entry"],
        "default": []
      },
      "/plotLine": {
        "type": "text",
        "label": "所属剧情线",
        "required": true
      }
    }
  }
}
