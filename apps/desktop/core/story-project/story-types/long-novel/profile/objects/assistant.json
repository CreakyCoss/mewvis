{
  "analysis-source": {
    "label": "分析来源",
    "fields": {
      "/title": {
        "type": "text",
        "label": "来源标题",
        "required": true
      },
      "/platform": {
        "type": "text",
        "label": "来源平台",
        "required": true
      },
      "/path": {
        "type": "path",
        "label": "来源路径",
        "required": false
      },
      "/wordCount": {
        "type": "integer",
        "label": "字数",
        "required": true,
        "minimum": 0
      },
      "/chapterCount": {
        "type": "integer",
        "label": "章节数",
        "required": true,
        "minimum": 0
      }
    }
  },
  "analysis-stage": {
    "label": "结构分析阶段",
    "fields": {
      "/name": {
        "type": "text",
        "label": "阶段名称",
        "required": true
      },
      "/range": {
        "type": "text",
        "label": "范围",
        "required": true
      },
      "/function": {
        "type": "textarea",
        "label": "结构功能",
        "required": true
      },
      "/emotion": {
        "type": "textarea",
        "label": "情绪作用",
        "required": true
      },
      "/evidence": {
        "type": "string-list",
        "label": "证据",
        "required": true,
        "default": []
      }
    }
  },
  "character-insight": {
    "label": "人物分析",
    "fields": {
      "/name": {
        "type": "text",
        "label": "人物",
        "required": true
      },
      "/role": {
        "type": "text",
        "label": "角色功能",
        "required": true
      },
      "/function": {
        "type": "textarea",
        "label": "叙事作用",
        "required": true
      },
      "/arc": {
        "type": "textarea",
        "label": "人物弧",
        "required": true
      },
      "/evidence": {
        "type": "string-list",
        "label": "证据",
        "required": true,
        "default": []
      }
    }
  },
  "review-finding": {
    "label": "审查问题",
    "identityPointer": "/id",
    "fields": {
      "/id": {
        "type": "id",
        "label": "问题 ID",
        "required": true,
        "immutable": true
      },
      "/severity": {
        "type": "enum",
        "label": "严重级别",
        "required": true,
        "options": [
          {
            "value": "S1",
            "label": "S1 严重"
          },
          {
            "value": "S2",
            "label": "S2 重要"
          },
          {
            "value": "S3",
            "label": "S3 局部"
          },
          {
            "value": "S4",
            "label": "S4 建议"
          }
        ]
      },
      "/category": {
        "type": "enum",
        "label": "问题类别",
        "required": true,
        "options": [
          {
            "value": "structure",
            "label": "结构"
          },
          {
            "value": "character",
            "label": "人物"
          },
          {
            "value": "prose",
            "label": "文字"
          },
          {
            "value": "consistency",
            "label": "一致性"
          },
          {
            "value": "platform",
            "label": "平台"
          },
          {
            "value": "factual",
            "label": "事实"
          },
          {
            "value": "format",
            "label": "格式"
          },
          {
            "value": "causal",
            "label": "因果"
          },
          {
            "value": "rule-boundary",
            "label": "规则边界"
          }
        ]
      },
      "/scopePath": {
        "type": "path",
        "label": "问题位置",
        "required": true
      },
      "/evidence": {
        "type": "textarea",
        "label": "证据",
        "required": true
      },
      "/issue": {
        "type": "textarea",
        "label": "问题说明",
        "required": true
      },
      "/fix": {
        "type": "textarea",
        "label": "修复建议",
        "required": true
      },
      "/status": {
        "type": "enum",
        "label": "处理状态",
        "required": true,
        "options": [
          {
            "value": "open",
            "label": "待处理"
          },
          {
            "value": "accepted",
            "label": "已接受"
          },
          {
            "value": "resolved",
            "label": "已解决"
          },
          {
            "value": "dismissed",
            "label": "已忽略"
          }
        ]
      }
    }
  }
}
