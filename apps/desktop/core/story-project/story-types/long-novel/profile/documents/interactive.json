{
  "story-scene": {
    "label": "互动场景",
    "layoutPresence": "required",
    "cardinality": "many",
    "titlePointer": "/title",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-scene"
    },
    "fields": {
      "/title": {
        "type": "text",
        "label": "场景标题",
        "required": true
      },
      "/scene": {
        "type": "textarea",
        "label": "场景描述",
        "required": true
      },
      "/goal": {
        "type": "textarea",
        "label": "场景目标",
        "required": true
      },
      "/plot": {
        "type": "textarea",
        "label": "剧情内容",
        "required": true
      },
      "/direction": {
        "type": "textarea",
        "label": "推进方向",
        "required": true
      },
      "/transition": {
        "type": "textarea",
        "label": "转场",
        "required": true
      },
      "/memory": {
        "type": "textarea",
        "label": "场景记忆",
        "required": true
      },
      "/status": {
        "type": "object",
        "label": "场景状态",
        "required": false,
        "definition": "scene-status"
      }
    }
  },
  "story-graph": {
    "label": "互动剧情图",
    "layoutPresence": "required",
    "cardinality": "one",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-graph"
    },
    "fields": {
      "/nodes": {
        "type": "collection",
        "label": "节点",
        "required": true,
        "itemDefinition": "graph-node",
        "default": []
      },
      "/edges": {
        "type": "collection",
        "label": "连接",
        "required": true,
        "itemDefinition": "graph-edge",
        "default": []
      }
    },
    "ruleIds": ["graph.nodes", "graph.edges", "reference.missing"]
  }
}
