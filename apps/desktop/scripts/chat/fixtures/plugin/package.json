{
  "name": "@isle-test/chat-client",
  "version": "0.0.0",
  "type": "module",
  "isle": {
    "plugin": {
      "version": 1,
      "entry": "./index.js"
    },
    "permissions": [
      "chat",
      "workspace-files",
      "chat-knowledge"
    ],
    "agentAccess": {
      "filesystem": {
        "read": "all",
        "write": "all"
      },
      "network": {
        "hosts": "all"
      },
      "process": {
        "execute": true
      }
    },
    "ui": {
      "version": 1,
      "kind": "sandbox",
      "entry": "./ui.tsx",
      "layout": "full"
    }
  }
}
