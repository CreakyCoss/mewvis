{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm sync-product-config && pnpm build:plugin-host && pnpm build:agent-runtime && vite",
    "build": "pnpm sync-product-config && pnpm build:plugin-host && pnpm build:agent-runtime && tsc && vite build",
    "build:plugin-host": "pnpm build:chat-ui && tsc -p plugin-host/tsconfig.json --noEmit && node plugin-host/scripts/build-service.mjs",
    "build:agent-runtime": "tsc -p agent-runtime/tsconfig.json --noEmit && node agent-runtime/scripts/build-cli.mjs && node scripts/packaging/write-agent-runtime-package.mjs && node agent-runtime/scripts/copy-builtin-resources.mjs && node agent-runtime/scripts/pack-portable-plugins.mjs && node agent-runtime/scripts/copy-plugin-installer.mjs && node agent-runtime/scripts/copy-node-runtime.mjs",
    "build:agent-runtime:win-x64": "pnpm build:agent-runtime && node agent-runtime/scripts/copy-node-runtime.mjs --target win-x64",
    "build:agent-runtime:win-arm64": "pnpm build:agent-runtime && node agent-runtime/scripts/copy-node-runtime.mjs --target win-arm64",
    "build:agent-runtime:darwin-arm64": "pnpm build:agent-runtime && node agent-runtime/scripts/copy-node-runtime.mjs --target darwin-arm64",
    "build:agent-runtime:darwin-x64": "pnpm build:agent-runtime && node agent-runtime/scripts/copy-node-runtime.mjs --target darwin-x64",
    "test:chat": "tsc -p scripts/chat/tsconfig.core.json && node scripts/chat/test-core.mjs && node scripts/chat/test-host.mjs",
    "test:chat:stdio": "node scripts/chat/stdio-e2e.mjs",
    "test:agent-runtime:e2e": "node scripts/agent-runtime/single-agent-e2e.mjs",
    "test:agent-runtime:idle-timeout": "node scripts/agent-runtime/idle-timeout-e2e.mjs",
    "test:agent-runtime:user-input": "node scripts/agent-runtime/user-input-e2e.mjs",
    "generate:agent-runtime:protocol": "node agent-runtime/protocol/scripts/generate-bindings.mjs",
    "check:agent-runtime:protocol-bindings": "node agent-runtime/protocol/scripts/generate-bindings.mjs --check",
    "test:agent-runtime:protocol": "pnpm check:agent-runtime:protocol-bindings && pnpm build:agent-runtime && node scripts/agent-runtime/frontend-contract-e2e.mjs && node scripts/agent-runtime/protocol-stdio-e2e.mjs && cargo test --manifest-path src-tauri/Cargo.toml commands::agent_runtime::protocol::tests",
    "test:agent-runtime:live": "node scripts/agent-runtime/single-agent-live-e2e.mjs",
    "test:agent-runtime:collaboration": "node scripts/agent-runtime/collaboration-smoke.mjs",
    "test:agent-runtime:collaboration:stdio": "node scripts/agent-runtime/collaboration-stdio-e2e.mjs",
    "test:agent-runtime:dsh-compat": "node scripts/agent-runtime/dsh-compat-e2e.mjs",
    "test:plugin-host:dsh-compat": "node scripts/plugin-host/dsh-compat-e2e.mjs",
    "test:plugin-host:rss": "pnpm build:plugin-host && node scripts/plugin-host/rss-plugin-e2e.mjs",
    "test:plugin-host:story-scene-card": "pnpm build:plugin-host && node scripts/plugin-host/story-scene-card-e2e.mjs",
    "test:plugin-host:tavern": "pnpm build:plugin-host && node scripts/plugin-host/tavern-plugin-e2e.mjs",
    "test:plugin-host:ui": "pnpm build:plugin-host && node scripts/plugin-host/ui-service-e2e.mjs",
    "test:plugin-host:tooling": "pnpm build:plugin-host && node scripts/plugin-host/plugin-tooling-e2e.mjs",
    "plugin:create": "node plugin-host/scripts/plugin-cli.mjs create",
    "plugin:validate": "node plugin-host/scripts/plugin-cli.mjs validate",
    "plugin:pack": "node plugin-host/scripts/plugin-cli.mjs pack",
    "test:story:core": "node scripts/business/story/core-e2e.mjs",
    "test:story:contract": "node scripts/business/story/contract-e2e.mjs",
    "test:story:commit-tool": "node scripts/business/story/commit-tool-e2e.mjs",
    "test:story:builtin-binding": "node scripts/business/story/builtin-binding-e2e.mjs",
    "test:story:runtime-boundary": "node scripts/business/story/runtime-boundary-e2e.mjs",
    "test:story:tavern-protocol": "node scripts/business/story/tavern-agent-protocol-e2e.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "build:mac": "node scripts/packaging/build-macos.mjs",
    "build:mac:arm64": "node scripts/packaging/build-macos.mjs --target darwin-arm64",
    "build:mac:x64": "node scripts/packaging/build-macos.mjs --target darwin-x64",
    "build:win": "node scripts/packaging/build-windows.mjs x64",
    "build:win:arm64": "node scripts/packaging/build-windows.mjs arm64",
    "sync-product-config": "node scripts/maintenance/sync-product-config.mjs",
    "sync-models": "node scripts/maintenance/sync-models.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "init:config-db": "cargo run --manifest-path src-tauri/Cargo.toml --bin init_config_db --",
    "rebuild:config-db": "cargo run --manifest-path src-tauri/Cargo.toml --bin init_config_db -- --rebuild",
    "init:config-db:rebuild-on-error": "cargo run --manifest-path src-tauri/Cargo.toml --bin init_config_db -- --rebuild-on-error",
    "build:chat-ui": "node scripts/chat/build-plugin-ui.mjs",
    "check:chat-ui-types": "node scripts/chat/build-plugin-ui.mjs --check-types",
    "test:chat:plugin": "pnpm build:plugin-host && pnpm exec tsc -p scripts/chat/tsconfig.plugin.json && node plugin-host/scripts/plugin-cli.mjs pack scripts/chat/fixtures/plugin && node scripts/chat/test-plugin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings-file": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-ai": "workspace:*",
    "@earendil-works/pi-coding-agent": "workspace:*",
    "@isle/plugin-sdk": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@lexical/react": "^0.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "dsh-rss": "0.2.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "4.1.1",
    "lexical": "^0.48.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.500.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.1",
    "react-router": "^7.18.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.2.0",
    "zustand": "^5.0.0",
    "@isle/chat-contracts": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "json-schema-to-typescript": "15.0.4",
    "pnpm": "11.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.9.3",
    "quicktype": "26.0.0",
    "rollup": "4.60.4",
    "rollup-plugin-dts": "6.5.1",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
