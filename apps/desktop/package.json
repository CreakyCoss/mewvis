{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm sync-product-config && pnpm build:agent-bridge && vite",
    "build": "pnpm sync-product-config && pnpm build:agent-bridge && tsc && vite build",
    "build:agent-bridge": "tsc -p agent-bridge/tsconfig.json --noEmit && esbuild agent-bridge/src/index.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire as __bridgeCreateRequire } from 'node:module'; const require = __bridgeCreateRequire(import.meta.url);\" --outfile=agent-bridge/dist/index.js && node scripts/write-agent-bridge-package.mjs && node agent-bridge/scripts/copy-node-runtime.mjs",
    "build:agent-bridge:win-x64": "pnpm build:agent-bridge && node agent-bridge/scripts/copy-node-runtime.mjs --target win-x64",
    "build:agent-bridge:win-arm64": "pnpm build:agent-bridge && node agent-bridge/scripts/copy-node-runtime.mjs --target win-arm64",
    "build:agent-bridge:darwin-arm64": "pnpm build:agent-bridge && node agent-bridge/scripts/copy-node-runtime.mjs --target darwin-arm64",
    "build:agent-bridge:darwin-x64": "pnpm build:agent-bridge && node agent-bridge/scripts/copy-node-runtime.mjs --target darwin-x64",
    "test:agent-bridge:e2e": "node scripts/agent-bridge-e2e.mjs",
    "test:agent-bridge:live": "node scripts/agent-bridge-live-e2e.mjs",
    "test:tavern:core": "node scripts/tavern-core-e2e.mjs",
    "test:tavern:prompt-layer": "node scripts/tavern-prompt-layer-e2e.mjs",
    "test:tavern:prompt-preview": "node scripts/tavern-prompt-preview-e2e.mjs",
    "test:tavern:preset-20": "node scripts/tavern-preset-20-round-e2e.mjs",
    "test:tavern:live": "node scripts/tavern-live-llm-e2e.mjs",
    "test:tavern:prompt-quality": "node scripts/tavern-prompt-quality-eval.mjs",
    "build:mac": "node scripts/build-macos.mjs",
    "build:mac:arm64": "node scripts/build-macos.mjs --target darwin-arm64",
    "build:mac:x64": "node scripts/build-macos.mjs --target darwin-x64",
    "build:win": "node scripts/build-windows.mjs x64",
    "build:win:arm64": "node scripts/build-windows.mjs arm64",
    "sync-product-config": "node scripts/sync-product-config.mjs",
    "sync-models": "node scripts/sync-models.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "init:config-db": "cargo run --manifest-path src-tauri/Cargo.toml --bin init_config_db --",
    "rebuild:config-db": "cargo run --manifest-path src-tauri/Cargo.toml --bin init_config_db -- --rebuild",
    "init:config-db:rebuild-on-error": "cargo run --manifest-path src-tauri/Cargo.toml --bin init_config_db -- --rebuild-on-error"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@earendil-works/pi-ai": "workspace:*",
    "@earendil-works/pi-coding-agent": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.500.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.1",
    "react-router": "^7.18.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
