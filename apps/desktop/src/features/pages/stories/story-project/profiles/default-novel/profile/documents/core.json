{
  "story-manifest": {
    "label": "故事清单",
    "description": "索引所有正式故事文件并维护 revision",
    "pathPattern": "story/manifest.json",
    "cardinality": "one",
    "titlePointer": "/title",
    "fields": {
      "/schemaVersion": {
        "type": "integer",
        "label": "结构版本",
        "required": true,
        "readOnly": true,
        "const": 1
      },
      "/kind": {
        "type": "text",
        "label": "文档类型",
        "required": true,
        "readOnly": true,
        "const": "story-manifest"
      },
      "/storyId": {
        "type": "id",
        "label": "故事 ID",
        "required": true,
        "immutable": true
      },
      "/title": {
        "type": "text",
        "label": "故事标题",
        "required": true,
        "generatedFrom": "story-book:/title"
      },
      "/revision": {
        "type": "integer",
        "label": "数据版本",
        "required": true,
        "generated": true,
        "readOnly": true,
        "minimum": 0
      },
      "/createdAt": {
        "type": "timestamp",
        "label": "创建时间",
        "required": true,
        "generated": true,
        "readOnly": true
      },
      "/updatedAt": {
        "type": "timestamp",
        "label": "更新时间",
        "required": true,
        "generated": true,
        "readOnly": true
      },
      "/files": {
        "type": "collection",
        "label": "文件索引",
        "required": true,
        "generated": true,
        "readOnly": true,
        "itemDefinition": "manifest-file-entry"
      }
    },
    "ruleIds": ["manifest.files", "manifest.title"]
  },
  "story-book": {
    "label": "作品核心",
    "description": "书名、故事前提、目标、核心冲突与终局阻碍",
    "pathPattern": "story/book.json",
    "cardinality": "one",
    "titlePointer": "/title",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-book"
    },
    "fields": {
      "/title": {
        "type": "text",
        "label": "书名",
        "required": true,
        "default": ""
      },
      "/premise": {
        "type": "textarea",
        "label": "故事前提",
        "required": true,
        "default": ""
      },
      "/goal": {
        "type": "textarea",
        "label": "全书目标",
        "required": true,
        "default": ""
      },
      "/logline": {
        "type": "textarea",
        "label": "一句话梗概",
        "required": true,
        "default": ""
      },
      "/centralConflict": {
        "type": "textarea",
        "label": "核心冲突",
        "required": true,
        "default": ""
      },
      "/finalObstacle": {
        "type": "textarea",
        "label": "终极阻碍",
        "required": true,
        "default": ""
      },
      "/protagonistId": {
        "type": "reference",
        "label": "主角",
        "required": false,
        "targetKinds": ["story-character"]
      },
      "/playerName": {
        "type": "text",
        "label": "玩家称呼",
        "required": true,
        "default": "我"
      },
      "/mode": {
        "type": "enum",
        "label": "故事模式",
        "required": true,
        "default": "hybrid",
        "options": [
          {
            "value": "serial",
            "label": "连载"
          },
          {
            "value": "interactive",
            "label": "互动"
          },
          {
            "value": "hybrid",
            "label": "混合"
          }
        ]
      },
      "/createdAt": {
        "type": "timestamp",
        "label": "创建时间",
        "required": true,
        "generated": true,
        "readOnly": true
      }
    },
    "ruleIds": ["book.title", "book.logline", "opening.protagonist"]
  },
  "story-positioning": {
    "label": "作品定位",
    "pathPattern": "story/positioning.json",
    "cardinality": "one",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-positioning"
    },
    "fields": {
      "/lengthType": {
        "type": "enum",
        "label": "篇幅类型",
        "required": true,
        "options": [
          {
            "value": "long",
            "label": "长篇"
          },
          {
            "value": "short",
            "label": "短篇"
          }
        ]
      },
      "/primaryGenre": {
        "type": "text",
        "label": "主类型",
        "required": true,
        "default": ""
      },
      "/secondaryGenres": {
        "type": "string-list",
        "label": "副类型",
        "required": true,
        "default": []
      },
      "/targetPlatform": {
        "type": "text",
        "label": "目标平台",
        "required": true,
        "default": ""
      },
      "/targetAudience": {
        "type": "textarea",
        "label": "目标读者",
        "required": true,
        "default": ""
      },
      "/targetWords": {
        "type": "integer",
        "label": "目标字数",
        "required": true,
        "minimum": 0,
        "default": 0
      },
      "/emotionalPromise": {
        "type": "textarea",
        "label": "情绪承诺",
        "required": true,
        "default": ""
      },
      "/surfaceHook": {
        "type": "textarea",
        "label": "表层卖点",
        "required": true,
        "default": ""
      },
      "/deepPayoff": {
        "type": "textarea",
        "label": "深层满足",
        "required": true,
        "default": ""
      },
      "/longTermHook": {
        "type": "textarea",
        "label": "长期钩子",
        "required": true,
        "default": ""
      },
      "/differentiation": {
        "type": "textarea",
        "label": "差异化",
        "required": true,
        "default": ""
      },
      "/benchmarkTitles": {
        "type": "string-list",
        "label": "对标作品",
        "required": true,
        "default": []
      }
    }
  },
  "story-style": {
    "label": "文风约束",
    "pathPattern": "story/style.json",
    "cardinality": "one",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-style"
    },
    "fields": {
      "/tone": {
        "type": "textarea",
        "label": "整体语气",
        "required": true,
        "default": ""
      },
      "/pointOfView": {
        "type": "text",
        "label": "叙事视角",
        "required": true,
        "default": ""
      },
      "/tense": {
        "type": "text",
        "label": "叙事时态",
        "required": true,
        "default": ""
      },
      "/sentenceRhythm": {
        "type": "textarea",
        "label": "句式节奏",
        "required": true,
        "default": ""
      },
      "/dialogueGuidance": {
        "type": "textarea",
        "label": "对话指导",
        "required": true,
        "default": ""
      },
      "/punctuationGuidance": {
        "type": "textarea",
        "label": "标点指导",
        "required": true,
        "default": ""
      },
      "/forbiddenPatterns": {
        "type": "string-list",
        "label": "禁止表达",
        "required": true,
        "default": []
      }
    },
    "ruleIds": ["style.tone"]
  }
}
