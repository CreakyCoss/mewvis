{
  "story-character": {
    "label": "角色档案",
    "pathPattern": "story/characters/{id}.json",
    "cardinality": "many",
    "titlePointer": "/name",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-character"
    },
    "fields": {
      "/name": {
        "type": "text",
        "label": "姓名",
        "required": true
      },
      "/role": {
        "type": "enum",
        "label": "角色定位",
        "required": true,
        "options": [
          {
            "value": "protagonist",
            "label": "主角"
          },
          {
            "value": "deuteragonist",
            "label": "第二主角"
          },
          {
            "value": "antagonist",
            "label": "对手"
          },
          {
            "value": "supporting",
            "label": "配角"
          },
          {
            "value": "minor",
            "label": "次要角色"
          }
        ]
      },
      "/avatar": {
        "type": "text",
        "label": "头像标识",
        "required": true,
        "default": "blank-avatar"
      },
      "/age": {
        "type": "text",
        "label": "年龄",
        "required": true,
        "default": ""
      },
      "/description": {
        "type": "textarea",
        "label": "角色简介",
        "required": true,
        "default": ""
      },
      "/traits": {
        "type": "string-list",
        "label": "性格特征",
        "required": true,
        "default": []
      },
      "/speakingStyle": {
        "type": "textarea",
        "label": "说话风格",
        "required": true,
        "default": ""
      },
      "/writingStyle": {
        "type": "textarea",
        "label": "书写风格",
        "required": true,
        "default": ""
      },
      "/replyStylePrompt": {
        "type": "textarea",
        "label": "回复风格提示",
        "required": true,
        "default": ""
      },
      "/goals": {
        "type": "textarea",
        "label": "角色目标",
        "required": true,
        "default": ""
      },
      "/motivation": {
        "type": "textarea",
        "label": "核心动机",
        "required": true,
        "default": ""
      },
      "/flaw": {
        "type": "textarea",
        "label": "缺陷",
        "required": true,
        "default": ""
      },
      "/coreAbility": {
        "type": "textarea",
        "label": "核心能力",
        "required": true,
        "default": ""
      },
      "/relationshipSummary": {
        "type": "textarea",
        "label": "关系摘要",
        "required": true,
        "default": ""
      },
      "/publicRelationshipSummary": {
        "type": "textarea",
        "label": "公开关系摘要",
        "required": true,
        "default": ""
      },
      "/arcSummary": {
        "type": "textarea",
        "label": "人物弧",
        "required": true,
        "default": ""
      },
      "/memory": {
        "type": "object",
        "label": "记忆分层",
        "required": true,
        "definition": "character-memory"
      }
    }
  },
  "story-relationships": {
    "label": "角色关系网",
    "pathPattern": "story/relationships.json",
    "cardinality": "one",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-relationships"
    },
    "fields": {
      "/relationships": {
        "type": "collection",
        "label": "关系",
        "required": true,
        "itemDefinition": "relationship",
        "default": []
      }
    },
    "ruleIds": ["identity.duplicate", "reference.missing"]
  },
  "story-world-entry": {
    "label": "世界设定",
    "description": "背景、力量体系、地理、社会、势力、物品和规则等可召回设定",
    "pathPattern": "story/world/{id}.json",
    "cardinality": "many",
    "titlePointer": "/title",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-world-entry"
    },
    "fields": {
      "/category": {
        "type": "enum",
        "label": "设定类别",
        "required": true,
        "options": [
          {
            "value": "background",
            "label": "时代与故事背景"
          },
          {
            "value": "power-system",
            "label": "力量体系"
          },
          {
            "value": "geography",
            "label": "地理"
          },
          {
            "value": "society",
            "label": "社会结构"
          },
          {
            "value": "faction",
            "label": "势力组织"
          },
          {
            "value": "object",
            "label": "关键物品"
          },
          {
            "value": "rule",
            "label": "世界规则"
          },
          {
            "value": "other",
            "label": "其他"
          }
        ]
      },
      "/title": {
        "type": "text",
        "label": "设定名称",
        "required": true
      },
      "/summary": {
        "type": "textarea",
        "label": "设定摘要",
        "required": true,
        "default": ""
      },
      "/content": {
        "type": "content",
        "label": "详细内容",
        "required": true,
        "default": ""
      },
      "/rules": {
        "type": "string-list",
        "label": "明确规则",
        "required": true,
        "default": []
      },
      "/constraints": {
        "type": "string-list",
        "label": "限制条件",
        "required": true,
        "default": []
      },
      "/keywords": {
        "type": "string-list",
        "label": "召回关键词",
        "required": true,
        "default": []
      },
      "/relatedEntityIds": {
        "type": "reference-list",
        "label": "关联对象",
        "required": true,
        "targetKinds": ["story-character", "story-world-entry"],
        "default": []
      },
      "/enabled": {
        "type": "boolean",
        "label": "启用",
        "required": true,
        "default": true
      },
      "/alwaysOn": {
        "type": "boolean",
        "label": "始终召回",
        "required": true,
        "default": false
      }
    }
  }
}
