{
  "graph-edge": {
    "label": "剧情连接",
    "identityPointer": "/id",
    "fields": {
      "/id": {
        "type": "id",
        "label": "连接 ID",
        "required": true,
        "immutable": true
      },
      "/fromNodeId": {
        "type": "reference",
        "label": "起点",
        "required": true,
        "targetObjectDefinitions": ["graph-node"]
      },
      "/toNodeId": {
        "type": "reference",
        "label": "终点",
        "required": true,
        "targetObjectDefinitions": ["graph-node"]
      },
      "/label": {
        "type": "text",
        "label": "选项文本",
        "required": true
      },
      "/reason": {
        "type": "textarea",
        "label": "连接原因",
        "required": false
      },
      "/isDefault": {
        "type": "boolean",
        "label": "默认路径",
        "required": false,
        "default": false
      },
      "/priority": {
        "type": "integer",
        "label": "优先级",
        "required": true
      }
    }
  },
  "graph-node": {
    "label": "剧情节点",
    "identityPointer": "/id",
    "fields": {
      "/id": {
        "type": "id",
        "label": "节点 ID",
        "required": true,
        "immutable": true
      },
      "/sceneId": {
        "type": "reference",
        "label": "场景",
        "required": false,
        "targetKinds": ["story-scene"]
      },
      "/title": {
        "type": "text",
        "label": "节点标题",
        "required": true
      },
      "/type": {
        "type": "text",
        "label": "节点类型",
        "required": true
      },
      "/pathRole": {
        "type": "text",
        "label": "路径作用",
        "required": true
      },
      "/status": {
        "type": "text",
        "label": "状态",
        "required": false
      }
    }
  },
  "scene-status": {
    "label": "场景状态",
    "fields": {
      "/location": {
        "type": "text",
        "label": "地点",
        "required": false
      },
      "/timeLabel": {
        "type": "text",
        "label": "时间",
        "required": false
      },
      "/weather": {
        "type": "text",
        "label": "天气",
        "required": false
      },
      "/atmosphere": {
        "type": "textarea",
        "label": "氛围",
        "required": false
      },
      "/scenePhase": {
        "type": "text",
        "label": "场景阶段",
        "required": false
      },
      "/immediateThreat": {
        "type": "textarea",
        "label": "即时威胁",
        "required": false
      }
    }
  }
}
