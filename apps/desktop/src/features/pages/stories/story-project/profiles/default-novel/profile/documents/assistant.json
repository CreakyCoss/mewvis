{
  "story-analysis": {
    "label": "故事分析",
    "layoutPresence": "optional",
    "cardinality": "many",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-analysis"
    },
    "fields": {
      "/analysisType": {
        "type": "enum",
        "label": "分析篇幅",
        "required": true,
        "options": [
          {
            "value": "long",
            "label": "长篇"
          },
          {
            "value": "short",
            "label": "短篇"
          }
        ]
      },
      "/target": {
        "type": "enum",
        "label": "分析目标",
        "required": true,
        "options": [
          {
            "value": "current-story",
            "label": "当前故事"
          },
          {
            "value": "benchmark",
            "label": "对标作品"
          },
          {
            "value": "import-source",
            "label": "导入来源"
          }
        ]
      },
      "/status": {
        "type": "enum",
        "label": "分析状态",
        "required": true,
        "options": [
          {
            "value": "draft",
            "label": "草稿"
          },
          {
            "value": "partial",
            "label": "部分完成"
          },
          {
            "value": "complete",
            "label": "已完成"
          }
        ]
      },
      "/source": {
        "type": "object",
        "label": "分析来源",
        "required": true,
        "definition": "analysis-source"
      },
      "/summary": {
        "type": "textarea",
        "label": "分析摘要",
        "required": true
      },
      "/storyCore": {
        "type": "textarea",
        "label": "故事核",
        "required": true
      },
      "/structureStages": {
        "type": "collection",
        "label": "结构阶段",
        "required": true,
        "itemDefinition": "analysis-stage",
        "default": []
      },
      "/turningPoints": {
        "type": "string-list",
        "label": "关键转折",
        "required": true,
        "default": []
      },
      "/emotionalArc": {
        "type": "collection",
        "label": "情绪弧",
        "required": true,
        "itemDefinition": "emotional-arc-point",
        "default": []
      },
      "/plotModules": {
        "type": "collection",
        "label": "剧情模块",
        "required": true,
        "itemDefinition": "plot-module",
        "default": []
      },
      "/styleProfile": {
        "type": "object",
        "label": "文风画像",
        "required": true,
        "definition": "style-profile"
      },
      "/characterInsights": {
        "type": "collection",
        "label": "人物分析",
        "required": true,
        "itemDefinition": "character-insight",
        "default": []
      },
      "/worldInsights": {
        "type": "string-list",
        "label": "世界观分析",
        "required": true,
        "default": []
      },
      "/reusableTechniques": {
        "type": "string-list",
        "label": "可复用技巧",
        "required": true,
        "default": []
      },
      "/gaps": {
        "type": "string-list",
        "label": "证据缺口",
        "required": true,
        "default": []
      },
      "/createdAt": {
        "type": "timestamp",
        "label": "创建时间",
        "required": true,
        "generated": true,
        "readOnly": true
      }
    }
  },
  "story-review": {
    "label": "审稿记录",
    "layoutPresence": "optional",
    "cardinality": "many",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-review"
    },
    "fields": {
      "/reviewType": {
        "type": "enum",
        "label": "记录类型",
        "required": true,
        "options": [
          {
            "value": "review",
            "label": "故事审查"
          },
          {
            "value": "deslop",
            "label": "去 AI 味"
          }
        ]
      },
      "/mode": {
        "type": "enum",
        "label": "审查模式",
        "required": true,
        "options": [
          {
            "value": "full",
            "label": "完整"
          },
          {
            "value": "lean",
            "label": "精简"
          },
          {
            "value": "solo",
            "label": "单章"
          },
          {
            "value": "detect",
            "label": "仅检测"
          },
          {
            "value": "rewrite",
            "label": "检测并改写"
          }
        ]
      },
      "/rubric": {
        "type": "text",
        "label": "审查标准",
        "required": true
      },
      "/scopePaths": {
        "type": "string-list",
        "label": "审查范围",
        "required": true,
        "default": []
      },
      "/summary": {
        "type": "textarea",
        "label": "审查摘要",
        "required": true
      },
      "/verdict": {
        "type": "enum",
        "label": "结论",
        "required": true,
        "options": [
          {
            "value": "approve",
            "label": "通过"
          },
          {
            "value": "concerns",
            "label": "存在问题"
          },
          {
            "value": "reject",
            "label": "需要重写"
          },
          {
            "value": "not-applicable",
            "label": "不适用"
          }
        ]
      },
      "/findings": {
        "type": "collection",
        "label": "问题列表",
        "required": true,
        "itemDefinition": "review-finding",
        "default": []
      },
      "/createdAt": {
        "type": "timestamp",
        "label": "创建时间",
        "required": true,
        "generated": true,
        "readOnly": true
      }
    }
  },
  "story-import": {
    "label": "导入记录",
    "layoutPresence": "optional",
    "cardinality": "many",
    "titlePointer": "/sourceTitle",
    "fieldSets": ["entity-document"],
    "constFields": {
      "/kind": "story-import"
    },
    "fields": {
      "/sourceTitle": {
        "type": "text",
        "label": "来源标题",
        "required": true
      },
      "/sourcePath": {
        "type": "path",
        "label": "来源路径",
        "required": false
      },
      "/lengthType": {
        "type": "enum",
        "label": "篇幅类型",
        "required": true,
        "options": [
          {
            "value": "long",
            "label": "长篇"
          },
          {
            "value": "short",
            "label": "短篇"
          }
        ]
      },
      "/status": {
        "type": "enum",
        "label": "导入状态",
        "required": true,
        "options": [
          {
            "value": "detected",
            "label": "已检测"
          },
          {
            "value": "analyzing",
            "label": "分析中"
          },
          {
            "value": "ready",
            "label": "可提交"
          },
          {
            "value": "committed",
            "label": "已落库"
          },
          {
            "value": "partial",
            "label": "部分完成"
          },
          {
            "value": "failed",
            "label": "失败"
          }
        ]
      },
      "/wordCount": {
        "type": "integer",
        "label": "字数",
        "required": true,
        "minimum": 0
      },
      "/chapterCount": {
        "type": "integer",
        "label": "章节数",
        "required": true,
        "minimum": 0
      },
      "/lastCompleteChapterNumber": {
        "type": "integer",
        "label": "最后完整章号",
        "required": true,
        "minimum": 0
      },
      "/analysisId": {
        "type": "reference",
        "label": "分析记录",
        "required": false,
        "targetKinds": ["story-analysis"]
      },
      "/generatedFileIds": {
        "type": "reference-list",
        "label": "生成对象",
        "required": true,
        "targetKinds": [
          "story-book",
          "story-character",
          "story-world-entry",
          "story-volume",
          "story-chapter-plan",
          "story-chapter",
          "story-scene",
          "story-analysis",
          "story-review",
          "story-import"
        ],
        "targetObjectDefinitions": ["relationship", "foreshadow", "timeline-entry", "graph-node"],
        "default": []
      },
      "/warnings": {
        "type": "string-list",
        "label": "警告与缺口",
        "required": true,
        "default": []
      },
      "/createdAt": {
        "type": "timestamp",
        "label": "创建时间",
        "required": true,
        "generated": true,
        "readOnly": true
      }
    }
  }
}
