{
  "name": "isle-claw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "extension": "node packages/extension/dev/cli.mjs",
    "test:extensions": "pnpm --filter @isle/extension-host test && pnpm --filter @isle/extension-adapters test && pnpm --filter @isle/extension-dev test && pnpm --filter @isle/agent-runtime test:extensions",
    "dev:server": "pnpm --filter @isle/server dev",
    "build:server": "pnpm --filter @isle/server build",
    "start:server": "pnpm --filter @isle/server start",
    "test:server": "pnpm --filter @isle/server test",
    "test:server:runtime": "pnpm --filter @isle/server test:runtime",
    "docs:check": "pnpm --filter @isle/builtin-applications docs:check",
    "docs:build": "pnpm --filter @isle/builtin-applications docs:build",
    "docs:test": "pnpm docs:build && pnpm --filter @isle/builtin-applications docs:test && pnpm --filter client build:app-host && node apps/client/scripts/docs/reader-e2e.mjs",
    "build:ai": "cd ai/pi && npm install && npm run build",
    "dev:desktop": "pnpm --filter @isle/desktop dev",
    "build:desktop": "pnpm --filter @isle/desktop build",
    "build:desktop:mac": "pnpm --filter @isle/desktop build:mac",
    "build:desktop:mac:arm64": "pnpm --filter @isle/desktop build:mac:arm64",
    "build:desktop:mac:x64": "pnpm --filter @isle/desktop build:mac:x64",
    "build:desktop:win": "pnpm --filter @isle/desktop build:win",
    "build:desktop:win:x64": "pnpm --filter @isle/desktop build:win",
    "build:desktop:win:arm64": "pnpm --filter @isle/desktop build:win:arm64",
    "sync-models": "pnpm --filter client sync-models",
    "format:desktop": "pnpm --filter client format",
    "format:desktop:check": "pnpm --filter client format:check",
    "init:config-db": "pnpm --filter client init:config-db",
    "rebuild:config-db": "pnpm --filter client rebuild:config-db",
    "init:config-db:rebuild-on-error": "pnpm --filter client init:config-db:rebuild-on-error",
    "test:server:interop": "pnpm --filter @isle/server test:interop",
    "dev:web": "pnpm build:server && pnpm --filter client dev:web",
    "build:web": "pnpm build:server && pnpm --filter client build",
    "start:web": "node apps/server/dist/cli.js --web",
    "test:web": "pnpm build:web && pnpm --filter client test:web",
    "build:runtime": "pnpm --filter @isle/agent-runtime build"
  }
}
