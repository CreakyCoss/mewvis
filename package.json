{
  "name": "mewvis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "win32"
      ],
      "cpu": [
        "current",
        "arm64",
        "x64"
      ]
    }
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @mewvis/desktop dev",
    "dev:web": "pnpm --filter client dev:web",
    "dev:server": "pnpm --filter @mewvis/server dev",
    "build:ai": "cd ai/pi && npm install && npm run build",
    "build:runtime": "pnpm --filter @mewvis/agent-runtime build",
    "build:server": "pnpm --filter @mewvis/server build",
    "build:web": "pnpm --filter client build",
    "build:desktop": "pnpm --filter @mewvis/desktop build",
    "build:desktop:mac": "pnpm --filter @mewvis/desktop build:mac",
    "build:desktop:mac:arm64": "pnpm --filter @mewvis/desktop build:mac:arm64",
    "build:desktop:mac:x64": "pnpm --filter @mewvis/desktop build:mac:x64",
    "build:desktop:win:x64": "pnpm --filter @mewvis/desktop build:win",
    "build:desktop:win:arm64": "pnpm --filter @mewvis/desktop build:win:arm64",
    "start:web": "node apps/server/dist/cli.js --web",
    "start:server": "pnpm --filter @mewvis/server start",
    "test:server": "pnpm --filter @mewvis/server test",
    "test:server:runtime": "pnpm --filter @mewvis/server test:runtime",
    "test:server:interop": "pnpm --filter @mewvis/server test:interop",
    "test:web": "pnpm build:web && pnpm --filter client test:web",
    "test:extensions": "pnpm --filter @mewvis/extension-host test && pnpm --filter @mewvis/extension-adapters test && pnpm --filter @mewvis/extension-dev test && pnpm --filter @mewvis/agent-runtime test:extensions",
    "test:product-config": "node --test scripts/maintenance/product-config.test.mjs",
    "docs:build": "pnpm --filter @mewvis/builtin-applications docs:build",
    "docs:check": "pnpm --filter @mewvis/builtin-applications docs:check",
    "docs:site:dev": "pnpm --filter @mewvis/docs-site dev",
    "docs:site:build": "pnpm --filter @mewvis/docs-site build",
    "docs:site:preview": "pnpm --filter @mewvis/docs-site preview",
    "docs:test": "pnpm docs:build && pnpm --filter @mewvis/builtin-applications docs:test && pnpm --filter client build:app-host && node apps/client/scripts/docs/reader-e2e.mjs",
    "format:desktop": "pnpm --filter client format",
    "format:desktop:check": "pnpm --filter client format:check",
    "extension": "node packages/extension/dev/cli.mjs",
    "sync-product-config": "node scripts/maintenance/sync-product-config.mjs",
    "check:product-config": "node scripts/maintenance/sync-product-config.mjs --check",
    "sync-models": "pnpm --filter client sync-models",
    "init:config-db": "pnpm --filter client init:config-db",
    "init:config-db:rebuild-on-error": "pnpm --filter client init:config-db:rebuild-on-error",
    "rebuild:config-db": "pnpm --filter client rebuild:config-db"
  }
}
