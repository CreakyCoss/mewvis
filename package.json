{
  "name": "isle-claw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev:server": "pnpm --filter @isle/server dev",
    "build:server": "pnpm --filter @isle/server build",
    "start:server": "pnpm --filter @isle/server start",
    "test:server": "pnpm --filter @isle/server test",
    "test:server:runtime": "pnpm --filter @isle/server test:runtime",
    "docs:check": "pnpm --filter @isle/builtin-applications docs:check",
    "docs:build": "pnpm --filter @isle/builtin-applications docs:build",
    "docs:test": "pnpm docs:build && pnpm --filter @isle/builtin-applications docs:test && pnpm --filter desktop build:app-host && node apps/desktop/scripts/docs/reader-e2e.mjs",
    "build:ai": "cd ai/pi && npm install && npm run build",
    "dev:desktop": "cd apps/desktop && pnpm tauri dev",
    "build:desktop": "cd apps/desktop && pnpm tauri build",
    "build:desktop:mac": "cd apps/desktop && pnpm build:mac",
    "build:desktop:mac:arm64": "cd apps/desktop && pnpm build:mac:arm64",
    "build:desktop:mac:x64": "cd apps/desktop && pnpm build:mac:x64",
    "build:desktop:win": "cd apps/desktop && pnpm build:win",
    "build:desktop:win:x64": "cd apps/desktop && pnpm build:win",
    "build:desktop:win:arm64": "cd apps/desktop && pnpm build:win:arm64",
    "sync-models": "pnpm --filter desktop sync-models",
    "format:desktop": "pnpm --filter desktop format",
    "format:desktop:check": "pnpm --filter desktop format:check",
    "init:config-db": "pnpm --filter desktop init:config-db",
    "rebuild:config-db": "pnpm --filter desktop rebuild:config-db",
    "init:config-db:rebuild-on-error": "pnpm --filter desktop init:config-db:rebuild-on-error",
    "test:server:interop": "pnpm --filter @isle/server test:interop",
    "dev:web": "pnpm build:server && pnpm --filter desktop dev:web",
    "build:web": "pnpm build:server && pnpm --filter desktop build",
    "start:web": "node apps/server/dist/cli.js --web",
    "test:web": "pnpm build:web && pnpm --filter desktop test:web",
    "build:runtime": "pnpm --filter @isle/agent-runtime build"
  }
}
